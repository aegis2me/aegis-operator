# Aegis Operator — secrets & configuration.
# Copy this file to  secret.env  (which is gitignored) and fill in real values.
# NEVER commit secret.env or paste real keys anywhere but this file.
#
# Loading:
#   PowerShell (Windows):  the launchers dot-source set-env.local.ps1 — put the same
#                          values there as $env:NAME = "value" (see set-env.local.ps1.example).
#   Python/bash:           export these, or the operator reads them from the environment.

# ---------------------------------------------------------------------------
# LLM provider for the operator co-pilot (OpenAI-compatible endpoint).
# Works with DeepSeek, OpenAI, or any OpenAI-compatible server (incl. a local one).
# ---------------------------------------------------------------------------
AEGIS_LLM_API_KEY=sk-your-key-here
AEGIS_LLM_ENDPOINT=https://api.deepseek.com
# AEGIS_MODEL is the CO-PILOT BRAIN (the operator seat that drives the loop + code-improvement).
# Pin it to deepseek-v4-pro -- the benchmarked co-pilot config (stronger reasoning/code than flash).
# The multi-model BOARD CHAT is a separate, cheaper path and may use flash for budget.
AEGIS_MODEL=deepseek-v4-pro
# AEGIS_CODE_MODEL=deepseek-v4-pro # code-suggester DeepSeek (code bench); defaults to v4-pro
# AEGIS_EXECUTOR_MODEL=            # optional; defaults to AEGIS_MODEL
# AEGIS_PROVIDER=                  # optional; auto-inferred from the endpoint
# AEGIS_LLM_REASONING=none         # none|low|medium|high (for reasoning models)

# ---------------------------------------------------------------------------
# Sol (GPT-5.6) as a second/third board analyst — direct OpenAI API. Optional.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# ---------------------------------------------------------------------------
# Cloudflare Workers AI — brings extra open models onto the board. Optional.
# Create a token with the "Workers AI" permission. Mind the free-tier Neuron/day cap.
# ---------------------------------------------------------------------------
CF_ACCOUNT_ID=your-32-hex-account-id
CF_API_TOKEN=your-workers-ai-token

# ---------------------------------------------------------------------------
# Runtime knobs (all optional).
# ---------------------------------------------------------------------------
# AEGIS_PYTHON=                    # full path to python.exe if not on PATH
# AEGIS_HOME=                      # project root override (defaults to repo dir)
# AEGIS_SCHEDULER_URL=             # optional external task scheduler; unused in the standalone stack
# AEGIS_BOARD_DIR=                 # board message directory for the live viewer
# AEGIS_REQUIRE_VPN=0              # 1 to run the VPN preflight in start-all.ps1 (needs vpn-ctl in Kali)
# AEGIS_VPN_REGION=United Kingdom
